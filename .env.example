# 复制为 .env 后按需修改（.env 已在 .gitignore 中）
# 生产环境务必修改所有密码，并只把 WEB_PORT 暴露给内网用户

# ── PostgreSQL ──
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=data_agent
DB_PASSWORD=Simple@123
DB_NAME=data_agent_db

# ── 初始管理员（仅在 users 表为空时生效；不设置密码则随机生成并打印到后端日志）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
AUTH_SESSION_TTL_HOURS=12

# ── 只读查询防护 ──
QUERY_MAX_ROWS=2000
QUERY_TIMEOUT_MS=15000

# ── 知识库 / RAG ──
KB_MAX_FILE_MB=30
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.5
# Embedding（OpenAI 兼容接口）——三选一：
# 1) 本地 Ollama（默认，免费、数据不出网）
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
# 2) 硅基流动云端（免费额度，同一向量空间，切换无需重建索引）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-...
# 3) 关闭向量检索，仅关键词检索
# EMBEDDING_PROVIDER=none
EMBEDDING_DIM=1024

# ── LLM（不配置时：知识问答返回抽取式答案，智能助手按规则路由）──
# 方式 1：Anthropic 兼容接口（DeepSeek / Claude）
LLM_PROVIDER=anthropic
# DEEPSEEK_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro
# 方式 2：OpenAI 兼容接口（DeepSeek / 通义千问 / vLLM / SGLang / Ollama）
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# 本地 Ollama 示例：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3.5:4b-mlx  LLM_NO_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_WINDOW=64000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_THINKING_BUDGET=0
LLM_SQL_REPAIR_ATTEMPTS=1

# ── 智能助手：推理与记忆 ──
AGENT_MAX_STEPS=8
MEMORY_ENABLED=true
MEMORY_RECALL_K=6
CONTEXT_COMPACT_RATIO=0.5
CONTEXT_KEEP_RECENT=6

# ── 密钥与自定义工具 ──
# 加密数据库中保存的模型 API Key、工具凭证。生产环境务必设置一个足够长的随机字符串并备份；
# 更换后已保存的 Key 需要重新填写。不设置时自动生成并保存在数据目录的 .secret_key
APP_SECRET_KEY=
# HTTP 工具默认禁止访问内网 / 本机地址（防 SSRF）；需要调用的内网系统在这里放行，逗号分隔
TOOL_HTTP_ALLOWED_HOSTS=
TOOL_HTTP_TIMEOUT_SECONDS=15

# ── Web ──
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
