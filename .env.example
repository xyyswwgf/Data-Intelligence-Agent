# 复制为 .env 后按需修改（.env 已在 .gitignore 中）

# ── PostgreSQL ──
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=data_agent
DB_PASSWORD=Simple@123
DB_NAME=data_agent_db

# ── 只读查询防护 ──
QUERY_MAX_ROWS=2000
QUERY_TIMEOUT_MS=15000

# ── LLM（Anthropic-compatible，三选一填 Key）──
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
LLM_SQL_REPAIR_ATTEMPTS=1

# ── Web ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYSIS_HISTORY_LIMIT=100
